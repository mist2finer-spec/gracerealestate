// Grace Choi Real Estate — database schema (PostgreSQL, e.g. Neon).
//
// DATABASE_URL           pooled connection, used by the running app
// DATABASE_URL_UNPOOLED  direct connection, used by `prisma migrate`
// (both are created automatically by the Neon integration on Vercel;
//  scripts/prebuild.mjs falls back to DATABASE_URL when it is missing)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// The currently published site content. A single row with id "main".
model SiteContent {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

/// Snapshot saved on every publish, so a previous version can be restored.
model ContentRevision {
  id        Int      @id @default(autoincrement())
  data      Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}
