# =====================================================
# Estata — Environment Variables (Example)
# Copy this file to `.env.local` and fill in real values.
# NEVER commit your real .env.local — it is gitignored.
# =====================================================

# --- Database (Prisma) ---
# For local dev: SQLite file (recommended for quick start)
DATABASE_URL="file:./dev.db"

# For production (Vercel / Render / Railway): use Postgres
# DATABASE_URL="postgresql://user:password@host:5432/estata?schema=public"

# --- NextAuth.js (for production auth — optional) ---
# Generate a secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Admin password ---
# Used by the demo admin panel (/admin route).
# Replace with a strong hash in production — never ship plaintext.
ESTATA_ADMIN_PASSWORD="estata-admin-2024"

# --- Public site URL (used for SEO / OG tags) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Estata"

# --- Image CDN (optional) ---
# If using Cloudinary / S3 / etc. for property images
# NEXT_PUBLIC_CDN_BASE_URL="https://your-cdn.example.com"
