# =====================================================
# Grace Choi Real Estate — Environment Variables (Example)
# Copy this file to `.env.local` and fill in real values.
# NEVER commit your real .env.local — it is gitignored.
# =====================================================

# --- Database (Postgres / Neon) ---
# On Vercel, connecting Neon from the Storage tab sets these automatically.
# Without a Postgres URL the site still runs, showing the default content,
# but the admin cannot publish.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection used for migrations. Optional locally.
# DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# --- Admin password ---
# Checked server-side by /api/admin/login (never sent to the browser).
# Also used to sign the admin session cookie — changing it signs everyone out.
# REQUIRED: the admin sign-in is disabled until this is set.
ADMIN_PASSWORD="change-me-to-a-long-random-password"

# --- Public site URL (used for SEO / OG tags) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Grace Choi Real Estate"

# --- Image CDN (optional) ---
# If using Cloudinary / S3 / etc. for property images
# NEXT_PUBLIC_CDN_BASE_URL="https://your-cdn.example.com"

# --- Inquiry email (Nodemailer → SMTP) ---
# All inquiries from the public site are sent to this address.
INQUIRY_TO_EMAIL="gracechoihappy@gmail.com"
# The address the email is sent FROM (usually your Gmail account).
INQUIRY_FROM_EMAIL="gracechoihappy@gmail.com"

# SMTP server config (for Gmail: smtp.gmail.com, port 465)
# Use a Gmail App Password — NOT your regular Gmail password.
# Create one at: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="gracechoihappy@gmail.com"
SMTP_PASS="replace-with-your-16-char-gmail-app-password"
